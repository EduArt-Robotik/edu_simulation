<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="eduard_uarm">

  <!-- Eduard (dein bestehendes Modell) -->
  <xacro:include filename="$(find edu_simulation)/model/eduard/eduard.urdf"/>

  <!-- uArm (als Part) -->
  <xacro:include filename="$(find edu_simulation)/model/uArm/urdf/uarm_part.urdf.xacro"/>

  <!-- Mount: Eduard base_link -> uArm uarm_base -->
  <joint name="uarm_mount" type="fixed">
    <parent link="base_link"/>
    <child link="uarm_base"/>
    <origin xyz="0.0 0.0 0.25" rpy="0 0 0"/>
  </joint>

</robot>
