<?xml version='1.0'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" name="$(arg robot_name)">
  <!-- Includes -->
  <xacro:include filename="$(find edu_simulation)/model/eduard/wheel.urdf"/>
  <xacro:include filename="$(find edu_simulation)/model/eduard/imu.urdf"/>
  <xacro:include filename="$(find edu_simulation)/model/eduard/range_sensor.urdf"/>
  <xacro:include filename="$(find edu_simulation)/model/eduard/lidar.urdf"/>

  <!-- Arguments -->
  <xacro:arg name="robot_name" default="eduard"/>
  <xacro:arg name="wheel_type" default="mecanum"/>

  <xacro:property name="wheel_type" value="$(arg wheel_type)"/>

  <!-- chassis -->
  <link name="base_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.00276" iyy="0.00882" izz="0.01119" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="visual">
      <xacro:if value="${'red' in '$(arg robot_name)'}">
        <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
        <geometry>
          <mesh filename="model://eduard/mesh/eduard-red-chassis.dae"/>
        </geometry>
      </xacro:if>
      <xacro:if value="${'green' in '$(arg robot_name)'}">
        <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
        <geometry>
          <mesh filename="model://eduard/mesh/eduard-green-chassis.dae"/>
        </geometry>
      </xacro:if>
      <xacro:if value="${'yellow' in '$(arg robot_name)'}">
        <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
        <geometry>
          <mesh filename="model://eduard/mesh/eduard-yellow-chassis.dae"/>
        </geometry>
      </xacro:if>
      <xacro:if value="${'blue' in '$(arg robot_name)'}">
        <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
        <geometry>
          <mesh filename="model://eduard/mesh/eduard-blue-chassis.dae"/>
        </geometry>
      </xacro:if>
      <xacro:unless value="${('red' in '$(arg robot_name)') or ('green' in '$(arg robot_name)') or ('yellow' in '$(arg robot_name)') or ('blue' in '$(arg robot_name)')}">
        <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
        <geometry>
          <mesh filename="model://eduard/mesh/eduard-blue-chassis.dae"/>
        </geometry>
      </xacro:unless>
    </visual>
    <collision name="collision_bottom">
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.22 0.02"/>
      </geometry>
    </collision>
    <collision name="collision_top">
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.22 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Wheels -->
  <!-- Rear Right -->
  <xacro:wheel name="motor_a" type="$(arg wheel_type)" parent_link="base_link">
    <origin xyz="-0.125 -0.18 0.02" rpy="-1.570796327 0 0"/>
  </xacro:wheel>
  <!-- Front Right -->
  <xacro:wheel name="motor_b" type="$(arg wheel_type)" parent_link="base_link">
    <origin xyz="0.125 -0.18 0.02" rpy="-1.570796327 0 0"/>
  </xacro:wheel>
  <!-- Rear Left -->
  <xacro:wheel name="motor_c" type="$(arg wheel_type)" parent_link="base_link">
    <origin xyz="-0.125 0.18 0.02" rpy="1.570796327 0 0"/>
  </xacro:wheel>  
  <!-- Front Left -->
  <xacro:wheel name="motor_d" type="$(arg wheel_type)" parent_link="base_link">
    <origin xyz="0.125 0.18 0.02" rpy="1.570796327 0 0"/>
  </xacro:wheel> 

  <!-- Wheel Friction for Mecanum -->
  <!-- TODO: would be nice to move this into wheel.urdf, but doesn't work there... -->
  <xacro:if value="${wheel_type == 'mecanum'}">
    <gazebo reference="motor_a_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>        
    </gazebo>
    <gazebo reference="motor_b_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>        
    </gazebo>
    <gazebo reference="motor_c_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>        
    </gazebo>
    <gazebo reference="motor_d_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>        
    </gazebo>
  </xacro:if>

  <!-- Sensors -->
  <xacro:imu name="imu" parent_link="base_link" topic_name="$(arg robot_name)/imu" visualize="false">
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </xacro:imu>

  <xacro:range_sensor name="range_front_left" parent_link="base_link" topic_name="$(arg robot_name)/range/front/left" visualize="true">
    <origin xyz="0.17 0.063 0.045" rpy="0 0 0"/>
  </xacro:range_sensor>
  <xacro:range_sensor name="range_front_right" parent_link="base_link" topic_name="$(arg robot_name)/range/front/right" visualize="true">
    <origin xyz="0.17 -0.063 0.045" rpy="0 0 0"/>
  </xacro:range_sensor>
  <xacro:range_sensor name="range_rear_left" parent_link="base_link" topic_name="$(arg robot_name)/range/rear/left" visualize="true">
    <origin xyz="-0.17 0.063 0.05" rpy="0 0 3.141592654"/>
  </xacro:range_sensor>
  <xacro:range_sensor name="range_rear_right" parent_link="base_link" topic_name="$(arg robot_name)/range/rear/right" visualize="true">
    <origin xyz="-0.17 -0.063 0.05" rpy="0 0 3.141592654"/>
  </xacro:range_sensor>

  <xacro:lidar name="lidar" parent_link="base_link" topic_name="scan" prefix="$(arg robot_name)">
    <origin xyz="0.115 0 0.07" rpy="0 0 0"/>
  </xacro:lidar>

  <!-- Plugins -->
  <gazebo>
    <plugin filename="libeduard-model-plugin.so" name="eduart::simulation::EduardModelPlugin">
      <kinematic value="$(arg wheel_type)"/>
      <motor name="motor_a" joint_name="motor_a_wheel_joint"/>
      <motor name="motor_b" joint_name="motor_b_wheel_joint"/>
      <motor name="motor_c" joint_name="motor_c_wheel_joint"/>
      <motor name="motor_d" joint_name="motor_d_wheel_joint"/>
    </plugin>
  </gazebo>

  <!-- World Plugins needed for Sensors -->
  <!-- TODO: should it moved to the world tag? Or is it okay here? Maybe its loaded multiple times here... -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
  </gazebo>
</robot>