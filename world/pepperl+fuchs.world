<?xml version="1.0"?>
<sdf version="1.6">
  <world name="pepperl+fuchs">

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.9 0.9 0.85 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>

      <direction>-0.5 0.3 -1.0</direction>

      <cast_shadows>true</cast_shadows>

      <!-- Attenuation is not applicable to directional lights
      <attenuation>
        <range>1000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation> -->
    </light>

    <scene>
      <grid>false</grid>
    </scene>
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <include>
      <uri>
        model://pepperl+fuchs
      </uri>
    </include>
  </world>
</sdf>